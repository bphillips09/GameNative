+fn handoff_ready_frame(stub_path: &Path, view: Option<&Path>, playfab: Option<&str>) -> serde_json::Value {
+    let mut environment = serde_json::Map::new();
+    if let Some(header) = playfab {
+        environment.insert("XODUS_XSTS_PLAYFAB".into(), header.into());
+    }
+    serde_json::json!({
+        "schema": 1,
+        "event": "ready",
+        "executable": stub_path.to_string_lossy(),
+        "workingDirectory": stub_path.parent().map(|dir| dir.to_string_lossy().into_owned()),
+        "view": view.map(|view| view.to_string_lossy().into_owned()),
+        "environment": environment,
+    })
+}
+
+/// Reports the prepared view, then holds it (and the license-derived keys in
+/// this process) until stdin sends `{"command":"stop"}`, stdin closes, or the
+/// process is interrupted. The caller removes the view afterwards.
+async fn run_handoff(stub_path: &Path, view: Option<&Path>, playfab: Option<String>) -> ExitCode {
+    use tokio::io::{AsyncBufReadExt, BufReader};
+    let ready = handoff_ready_frame(stub_path, view, playfab.as_deref());
+    println!("{HANDOFF_PREFIX}{ready}");
+    let mut lines = BufReader::new(tokio::io::stdin()).lines();
+    loop {
+        tokio::select! {
+            line = lines.next_line() => match line {
+                Ok(Some(line)) => {
+                    let stop = serde_json::from_str::<serde_json::Value>(&line)
+                        .is_ok_and(|value| value["command"] == "stop");
+                    if stop { break; }
+                }
+                Ok(None) | Err(_) => break,
+            },
+            _ = tokio::signal::ctrl_c() => break,
+        }
+    }
+    println!("{HANDOFF_PREFIX}{}", serde_json::json!({"schema": 1, "event": "stopped"}));
+    ExitCode::SUCCESS
+}
+
+/// Removes launch views left behind by a handoff process that was killed
+/// before it could clean up (they contain decrypted executables).
+pub fn sweep_stale_views(view_root: &Path) -> std::io::Result<usize> {
+    let mut removed = 0;
+    let Ok(items) = std::fs::read_dir(view_root) else { return Ok(0) };
+    for item in items {
+        let item = item?;
+        let name = item.file_name();
+        if name.to_string_lossy().starts_with(LAUNCH_VIEW_PREFIX) && item.file_type()?.is_dir() {
+            std::fs::remove_dir_all(item.path())?;
+            removed += 1;
+        }
+    }
+    Ok(removed)
+}
