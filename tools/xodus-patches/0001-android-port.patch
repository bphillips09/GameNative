diff --git a/crates/xodus/src/android_store.rs b/crates/xodus/src/android_store.rs
new file mode 100644
index 0000000..a9bd42b
--- /dev/null
+++ b/crates/xodus/src/android_store.rs
@@ -0,0 +1,216 @@
+//! Credential store for Android (cfg `xodus_android`).
+//!
+//! Android has neither the Secret Service nor a keychain reachable from a
+//! native executable, so credentials live as one file per entry inside a
+//! private directory (mode 0700). The host app passes the directory through
+//! `XODUS_SECRETS_DIR`; it should sit in the app's internal storage, which the
+//! Android sandbox already isolates from other apps.
+//!
+//! Unlike `keyring_core::sample::Store`, every write is persisted immediately
+//! and atomically (temp file, fsync, rename) and every read goes to disk, so
+//! the CLI and the account service can run at the same time without one
+//! overwriting the other's tokens.
+
+use std::any::Any;
+use std::collections::HashMap;
+use std::fs::{self, OpenOptions};
+use std::io::{ErrorKind, Write};
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use keyring_core::api::{CredentialApi, CredentialStoreApi};
+use keyring_core::{Credential, CredentialPersistence, Entry, Error, Result};
+use sha2::{Digest, Sha256};
+
+pub const SECRETS_DIR_ENV: &str = "XODUS_SECRETS_DIR";
+
+#[derive(Debug)]
+pub struct FileStore {
+    root: PathBuf,
+}
+
+impl FileStore {
+    pub fn new(root: impl Into<PathBuf>) -> Result<Arc<Self>> {
+        let root = root.into();
+        fs::create_dir_all(&root).map_err(platform)?;
+        fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).map_err(platform)?;
+        Ok(Arc::new(Self { root }))
+    }
+
+    /// `XODUS_SECRETS_DIR`, else `$HOME/.xodus-secrets`.
+    pub fn from_env() -> Result<Arc<Self>> {
+        let root = std::env::var_os(SECRETS_DIR_ENV)
+            .map(PathBuf::from)
+            .or_else(|| std::env::var_os("HOME").map(|home| Path::new(&home).join(".xodus-secrets")))
+            .ok_or_else(|| {
+                Error::NoStorageAccess(Box::from(format!(
+                    "{SECRETS_DIR_ENV} and HOME are both unset"
+                )))
+            })?;
+        Self::new(root)
+    }
+}
+
+impl CredentialStoreApi for FileStore {
+    fn vendor(&self) -> String {
+        "xodus-android-file-store".into()
+    }
+
+    fn id(&self) -> String {
+        self.root.to_string_lossy().into_owned()
+    }
+
+    fn build(
+        &self,
+        service: &str,
+        user: &str,
+        _modifiers: Option<&HashMap<&str, &str>>,
+    ) -> Result<Entry> {
+        if service.is_empty() || user.is_empty() {
+            return Err(Error::Invalid(
+                "service/user".into(),
+                "must not be empty".into(),
+            ));
+        }
+        let credential: Arc<Credential> = Arc::new(FileCredential {
+            path: self.root.join(entry_file_name(service, user)),
+            service: service.to_string(),
+            user: user.to_string(),
+        });
+        Ok(Entry::new_with_credential(credential))
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+
+    fn persistence(&self) -> CredentialPersistence {
+        CredentialPersistence::UntilDelete
+    }
+}
+
+#[derive(Debug)]
+struct FileCredential {
+    path: PathBuf,
+    service: String,
+    user: String,
+}
+
+impl CredentialApi for FileCredential {
+    fn set_secret(&self, secret: &[u8]) -> Result<()> {
+        write_atomic(&self.path, secret).map_err(platform)
+    }
+
+    fn get_secret(&self) -> Result<Vec<u8>> {
+        match fs::read(&self.path) {
+            Ok(bytes) => Ok(bytes),
+            Err(error) if error.kind() == ErrorKind::NotFound => Err(Error::NoEntry),
+            Err(error) => Err(platform(error)),
+        }
+    }
+
+    fn delete_credential(&self) -> Result<()> {
+        match fs::remove_file(&self.path) {
+            Ok(()) => Ok(()),
+            Err(error) if error.kind() == ErrorKind::NotFound => Err(Error::NoEntry),
+            Err(error) => Err(platform(error)),
+        }
+    }
+
+    fn get_credential(&self) -> Result<Option<Arc<Credential>>> {
+        // Same contract as the sample store: probe for existence, wrapper is self.
+        self.get_secret()?;
+        Ok(None)
+    }
+
+    fn get_specifiers(&self) -> Option<(String, String)> {
+        Some((self.service.clone(), self.user.clone()))
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+fn entry_file_name(service: &str, user: &str) -> String {
+    let mut hash = Sha256::new();
+    hash.update(service.as_bytes());
+    hash.update([0u8]);
+    hash.update(user.as_bytes());
+    let digest = hash.finalize();
+    let hex: String = digest.iter().map(|byte| format!("{byte:02x}")).collect();
+    format!("{hex}.secret")
+}
+
+fn write_atomic(path: &Path, bytes: &[u8]) -> std::io::Result<()> {
+    let dir = path.parent().ok_or_else(|| std::io::Error::other("secret has no parent"))?;
+    let tmp = dir.join(format!(
+        ".{}.{}.tmp",
+        path.file_name().and_then(|n| n.to_str()).unwrap_or("secret"),
+        std::process::id()
+    ));
+    {
+        let mut file = OpenOptions::new()
+            .write(true)
+            .create(true)
+            .truncate(true)
+            .mode(0o600)
+            .open(&tmp)?;
+        file.write_all(bytes)?;
+        file.sync_all()?;
+    }
+    if let Err(error) = fs::rename(&tmp, path) {
+        let _ = fs::remove_file(&tmp);
+        return Err(error);
+    }
+    if let Ok(dir) = fs::File::open(dir) {
+        let _ = dir.sync_all();
+    }
+    Ok(())
+}
+
+fn platform(error: std::io::Error) -> Error {
+    match error.kind() {
+        ErrorKind::PermissionDenied => Error::NoStorageAccess(Box::new(error)),
+        _ => Error::PlatformFailure(Box::new(error)),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn round_trip_is_visible_to_a_second_store_instance() {
+        let dir = tempfile::tempdir().unwrap();
+        let a = FileStore::new(dir.path()).unwrap();
+        let b = FileStore::new(dir.path()).unwrap();
+        let entry_a = a.build("Xodus Service", "device", None).unwrap();
+        let entry_b = b.build("Xodus Service", "device", None).unwrap();
+        assert!(matches!(entry_b.get_secret(), Err(Error::NoEntry)));
+        entry_a.set_secret(b"\x00binary\xffsecret").unwrap();
+        assert_eq!(entry_b.get_secret().unwrap(), b"\x00binary\xffsecret");
+        entry_b.set_password("replaced").unwrap();
+        assert_eq!(entry_a.get_password().unwrap(), "replaced");
+        entry_a.delete_credential().unwrap();
+        assert!(matches!(entry_b.get_secret(), Err(Error::NoEntry)));
+        assert!(matches!(entry_b.delete_credential(), Err(Error::NoEntry)));
+    }
+
+    #[test]
+    fn entries_are_isolated_and_private() {
+        let dir = tempfile::tempdir().unwrap();
+        let store = FileStore::new(dir.path().join("secrets")).unwrap();
+        store.build("svc", "one", None).unwrap().set_password("1").unwrap();
+        store.build("svc", "two", None).unwrap().set_password("2").unwrap();
+        assert_eq!(store.build("svc", "one", None).unwrap().get_password().unwrap(), "1");
+        let mode = fs::metadata(dir.path().join("secrets")).unwrap().permissions().mode();
+        assert_eq!(mode & 0o777, 0o700);
+        for item in fs::read_dir(dir.path().join("secrets")).unwrap() {
+            let mode = item.unwrap().metadata().unwrap().permissions().mode();
+            assert_eq!(mode & 0o777, 0o600);
+        }
+        assert!(store.build("", "x", None).is_err());
+    }
+}
