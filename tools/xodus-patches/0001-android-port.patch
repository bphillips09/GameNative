+    #[test]
+    fn handoff_view_materializes_encrypted_dlls_in_a_private_root() {
+        let root = tempfile::tempdir().unwrap();
+        let source = root.path().join("game");
+        std::fs::create_dir_all(source.join("Bin")).unwrap();
+        std::fs::write(source.join("Game.exe"), b"encrypted exe").unwrap();
+        std::fs::write(source.join("Bin/Protected.dll"), b"encrypted dll").unwrap();
+        std::fs::write(source.join("Bin/plain.pak"), b"plain").unwrap();
+        let mut exe = tempfile::tempfile().unwrap();
+        let mut dll = tempfile::tempfile().unwrap();
+        exe.write_all(&fake_pe()).unwrap();
+        dll.write_all(&fake_pe()).unwrap();
+        let exe_name = String::from("Game.exe");
+        let dll_name = String::from("Bin\\Protected.dll");
+        let files = [(&exe_name, exe.as_raw_fd()), (&dll_name, dll.as_raw_fd())];
+        let private = root.path().join("private-views");
+
+        // Desktop chain mode keeps DLLs encrypted (served by Wine file maps)...
+        let (desktop, _, desktop_count, _) = create_launch_chain_mirror(&source, &exe_name, &files).unwrap();
+        assert_eq!(desktop_count, 1);
+        // (no decrypted image under Bin, so the whole directory is a symlink to the source)
+        assert!(std::fs::symlink_metadata(desktop.path().join("Bin")).unwrap().file_type().is_symlink());
+
+        // ...the handoff view decrypts every image and lives under the view root.
+        let (view, entry, count, _) =
+            create_launch_view(&source, &exe_name, &files, Some(&private), true).unwrap();
+        assert_eq!(count, 2);
+        assert!(view.path().starts_with(&private));
+        assert!(view.path().file_name().unwrap().to_string_lossy().starts_with(LAUNCH_VIEW_PREFIX));
+        assert_eq!(entry, view.path().join("Game.exe"));
+        let dll_meta = std::fs::symlink_metadata(view.path().join("Bin/Protected.dll")).unwrap();
+        assert!(dll_meta.file_type().is_file());
+        assert_eq!(std::fs::read(view.path().join("Bin/Protected.dll")).unwrap(), fake_pe());
+        assert!(std::fs::symlink_metadata(view.path().join("Bin/plain.pak")).unwrap().file_type().is_symlink());
+        assert_eq!(std::fs::read(source.join("Bin/Protected.dll")).unwrap(), b"encrypted dll");
+    }
+
+    #[test]
+    fn handoff_ready_frame_carries_only_launch_facts() {
+        let frame = handoff_ready_frame(
+            Path::new("/views/xodus-view-1/Bin/Game.exe"),
+            Some(Path::new("/views/xodus-view-1")),
+            Some("XBL3.0 x=1;token"),
+        );
+        assert_eq!(frame["schema"], 1);
+        assert_eq!(frame["event"], "ready");
+        assert_eq!(frame["executable"], "/views/xodus-view-1/Bin/Game.exe");
+        assert_eq!(frame["workingDirectory"], "/views/xodus-view-1/Bin");
+        assert_eq!(frame["view"], "/views/xodus-view-1");
+        assert_eq!(frame["environment"]["XODUS_XSTS_PLAYFAB"], "XBL3.0 x=1;token");
+        let without = handoff_ready_frame(Path::new("/g/Game.exe"), None, None);
+        assert!(without["environment"].as_object().unwrap().is_empty());
+        assert!(without["view"].is_null());
+    }
+
+    #[test]
+    fn sweep_removes_only_stale_launch_views() {
+        let root = tempfile::tempdir().unwrap();
+        std::fs::create_dir_all(root.path().join(format!("{LAUNCH_VIEW_PREFIX}abc/Bin"))).unwrap();
+        std::fs::write(root.path().join(format!("{LAUNCH_VIEW_PREFIX}abc/Bin/Game.exe")), b"decrypted").unwrap();
+        std::fs::create_dir(root.path().join("keep-me")).unwrap();
+        std::fs::write(root.path().join(format!("{LAUNCH_VIEW_PREFIX}file")), b"not a dir").unwrap();
+        assert_eq!(sweep_stale_views(root.path()).unwrap(), 1);
+        assert!(root.path().join("keep-me").exists());
+        assert!(root.path().join(format!("{LAUNCH_VIEW_PREFIX}file")).exists());
+        assert_eq!(sweep_stale_views(&root.path().join("missing")).unwrap(), 0);
+    }
 }
