index 0000000..e38cae6
--- /dev/null
+++ b/crates/xodus/src/http.rs
@@ -0,0 +1,151 @@
+//! HTTP client construction.
+//!
+//! Every reqwest client in the backend is built here so trust roots can be
+//! configured per platform. On desktop this is plain `reqwest::Client::builder()`.
+//!
+//! On Android (cfg `xodus_android`) reqwest's default rustls verifier,
+//! rustls-platform-verifier, needs a JVM handle that a standalone native
+//! executable does not have and panics on first use. Instead the client trusts
+//! exactly the roots Android itself ships, read from disk:
+//!
+//! 1. `SSL_CERT_FILE` (a PEM bundle), if set and readable;
+//! 2. every file in `SSL_CERT_DIR` (colon separated), if set;
+//! 3. the updatable Conscrypt store and the system store:
+//!    `/apex/com.android.conscrypt/cacerts`, `/system/etc/security/cacerts`.
+//!
+//! The same variables steer OpenSSL, which xal's older reqwest uses for sign-in,
+//! so the host app should export `SSL_CERT_FILE` for both.
+
+pub fn client_builder() -> reqwest::ClientBuilder {
+    let builder = reqwest::Client::builder();
+    #[cfg(xodus_android)]
+    let builder = android_roots::apply(builder);
+    builder
+}
+
+/// Equivalent of `reqwest::Client::new()` with platform trust applied.
+pub fn client() -> reqwest::Client {
+    client_builder()
+        .build()
+        .expect("failed to build the HTTP client")
+}
+
+#[cfg(xodus_android)]
+pub mod android_roots {
+    use std::path::{Path, PathBuf};
+    use std::sync::OnceLock;
+
+    pub const SYSTEM_DIRS: [&str; 2] = [
+        "/apex/com.android.conscrypt/cacerts",
+        "/system/etc/security/cacerts",
+    ];
+
+    static ROOTS: OnceLock<Vec<reqwest::Certificate>> = OnceLock::new();
+
+    pub fn apply(builder: reqwest::ClientBuilder) -> reqwest::ClientBuilder {
+        let roots = ROOTS.get_or_init(|| {
+            let roots = load(
+                std::env::var_os("SSL_CERT_FILE").map(PathBuf::from).as_deref(),
+                std::env::var_os("SSL_CERT_DIR")
+                    .map(|value| std::env::split_paths(&value).collect::<Vec<_>>())
+                    .unwrap_or_default(),
+                SYSTEM_DIRS.iter().map(PathBuf::from).collect(),
+            );
+            if roots.is_empty() {
+                tracing::error!("no trusted root certificates found; TLS connections will fail");
+            } else {
+                tracing::debug!("loaded {} trusted root certificates", roots.len());
+            }
+            roots
+        });
+        // Only these roots: never fall through to the JVM-backed verifier.
+        builder.tls_certs_only(roots.iter().cloned())
+    }
+
+    /// The bundle wins when it yields certificates; otherwise directories are
+    /// scanned, explicit ones before the system defaults.
+    pub fn load(
+        bundle: Option<&Path>,
+        dirs: Vec<PathBuf>,
+        defaults: Vec<PathBuf>,
+    ) -> Vec<reqwest::Certificate> {
+        if let Some(bundle) = bundle {
+            if let Ok(bytes) = std::fs::read(bundle) {
+                let certs = parse(&bytes);
+                if !certs.is_empty() {
+                    return certs;
+                }
+            }
+        }
+        let mut certs = Vec::new();
+        for dir in dirs.into_iter().chain(defaults) {
+            let Ok(items) = std::fs::read_dir(&dir) else { continue };
+            let mut paths: Vec<_> = items.filter_map(|item| item.ok().map(|item| item.path())).collect();
+            paths.sort();
+            for path in paths {
+                if let Ok(bytes) = std::fs::read(&path) {
+                    certs.extend(parse(&bytes));
+                }
+            }
+            if !certs.is_empty() {
+                break;
+            }
+        }
+        certs
+    }
+
+    /// Android's cacerts files hold one PEM block plus an OpenSSL text dump;
+    /// only the PEM block is used. Unparseable files are skipped.
+    fn parse(bytes: &[u8]) -> Vec<reqwest::Certificate> {
+        reqwest::Certificate::from_pem_bundle(bytes).unwrap_or_default()
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        fn system_bundle() -> Option<Vec<u8>> {
+            ["/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt"]
+                .iter()
+                .find_map(|path| std::fs::read(path).ok())
+        }
+
+        fn first_pem(bundle: &[u8]) -> String {
+            let text = String::from_utf8_lossy(bundle);
+            let start = text.find("-----BEGIN CERTIFICATE-----").unwrap();
+            let end = text[start..].find("-----END CERTIFICATE-----").unwrap() + start + 25;
+            text[start..end].to_string()
+        }
+
+        #[test]
+        fn android_style_directory_is_parsed_and_noise_ignored() {
+            let Some(bundle) = system_bundle() else { return };
+            let dir = tempfile::tempdir().unwrap();
+            // Android layout: PEM followed by a text dump, hashed file names.
+            std::fs::write(
+                dir.path().join("5ad8a5d6.0"),
+                format!("{}\nCertificate:\n    Data:\n        Version: 3 (0x2)\nSHA1 Fingerprint=00:11\n", first_pem(&bundle)),
+            ).unwrap();
+            std::fs::write(dir.path().join("garbage.0"), "not a certificate").unwrap();
+            let certs = load(None, vec![], vec![dir.path().to_path_buf()]);
+            assert_eq!(certs.len(), 1);
+        }
+
+        #[test]
+        fn bundle_has_priority_and_empty_inputs_yield_nothing() {
+            let Some(bundle) = system_bundle() else { return };
+            let dir = tempfile::tempdir().unwrap();
+            let file = dir.path().join("bundle.pem");
+            std::fs::write(&file, &bundle).unwrap();
+            assert!(load(Some(&file), vec![], vec![]).len() > 10);
+            assert!(load(Some(&dir.path().join("missing")), vec![], vec![dir.path().join("none")]).is_empty());
+        }
+
+        #[test]
+        fn client_builds_with_explicit_roots() {
+            let Some(_) = system_bundle() else { return };
+            // Must not touch rustls-platform-verifier (which panics on Android).
+            let _ = super::super::client();
+        }
+    }
+}
