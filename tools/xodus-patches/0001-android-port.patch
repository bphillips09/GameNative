+
+/// Android exposes no SMBIOS to apps. Provisioning needs a stable SMBIOS
+/// Type 1 (System Information) record, so one is synthesized once from random
+/// data and persisted; the device license is bound to it, so it must never
+/// change for an installation. Losing it means provisioning a new device.
+#[cfg(xodus_android)]
+fn load_raw_smbios() -> io::Result<Vec<u8>> {
+    android_identity::load_or_create(&android_identity::path()?)
+}
+
+#[cfg(xodus_android)]
+pub mod android_identity {
+    use std::fs;
+    use std::io::{self, Read, Write};
+    use std::os::unix::fs::OpenOptionsExt;
+    use std::path::{Path, PathBuf};
+
+    pub const IDENTITY_FILE_ENV: &str = "XODUS_DEVICE_IDENTITY_FILE";
+    const FILE_NAME: &str = "device-smbios-type1.bin";
+
+    /// `XODUS_DEVICE_IDENTITY_FILE`, else beside the secrets.
+    pub fn path() -> io::Result<PathBuf> {
+        if let Some(path) = std::env::var_os(IDENTITY_FILE_ENV) {
+            return Ok(PathBuf::from(path));
+        }
+        let dir = std::env::var_os(crate::android_store::SECRETS_DIR_ENV)
+            .map(PathBuf::from)
+            .or_else(|| std::env::var_os("HOME").map(|home| Path::new(&home).join(".xodus-secrets")))
+            .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "no directory for the device identity"))?;
+        Ok(dir.join(FILE_NAME))
+    }
+
+    pub fn load_or_create(path: &Path) -> io::Result<Vec<u8>> {
+        match fs::read(path) {
+            Ok(bytes) if valid(&bytes) => return Ok(bytes),
+            Ok(_) => return Err(io::Error::new(io::ErrorKind::InvalidData, "stored device identity is corrupt")),
+            Err(error) if error.kind() != io::ErrorKind::NotFound => return Err(error),
+            Err(_) => {}
+        }
+        let dir = path.parent().ok_or_else(|| io::Error::other("identity path has no parent"))?;
+        fs::create_dir_all(dir)?;
+        let record = synthesize(
+            &random::<16>()?,
+            &hex(&random::<10>()?),
+            &std::env::var("XODUS_DEVICE_MANUFACTURER").unwrap_or_else(|_| "Android".into()),
+            &std::env::var("XODUS_DEVICE_MODEL").unwrap_or_else(|_| "Handheld".into()),
+        );
+        let tmp = dir.join(format!(".{FILE_NAME}.{}.tmp", std::process::id()));
+        {
+            let mut file = fs::OpenOptions::new().write(true).create(true).truncate(true).mode(0o600).open(&tmp)?;
+            file.write_all(&record)?;
+            file.sync_all()?;
+        }
+        // hard_link never replaces: if another process won the race, use its
+        // record. Where links are refused (some SELinux policies), fall back to
+        // a rename, which is only racy against a concurrent first launch.
+        let mut linked = fs::hard_link(&tmp, path);
+        if let Err(error) = &linked {
+            if error.kind() != io::ErrorKind::AlreadyExists && !path.exists() {
+                linked = fs::rename(&tmp, path);
+            }
+        }
+        let _ = fs::remove_file(&tmp);
+        match linked {
+            Ok(()) => Ok(record),
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
+                let bytes = fs::read(path)?;
+                if valid(&bytes) { Ok(bytes) } else { Err(io::Error::new(io::ErrorKind::InvalidData, "stored device identity is corrupt")) }
+            }
+            Err(error) => Err(error),
+        }
+    }
+
+    /// SMBIOS 2.4+ Type 1 record: header, string indexes, UUID, then strings.
+    pub fn synthesize(uuid: &[u8; 16], serial: &str, manufacturer: &str, model: &str) -> Vec<u8> {
+        let mut uuid = *uuid;
+        uuid[6] = (uuid[6] & 0x0f) | 0x40; // RFC 4122 version 4
+        uuid[8] = (uuid[8] & 0x3f) | 0x80; // variant
+        let mut record = vec![
+            1, 0x1b, 0x01, 0x00, // type 1, length 27, handle 0x0001
+            1, 2, 3, 4,          // manufacturer, product, version, serial
+        ];
+        record.extend_from_slice(&uuid);
+        record.extend_from_slice(&[6, 5, 6]); // wake-up: power switch; SKU, family
+        for text in [manufacturer, model, "1.0", serial, "Xodus Android", "Android"] {
+            let clean: String = text.chars().filter(|c| c.is_ascii_graphic() || *c == ' ').take(64).collect();
+            record.extend_from_slice(if clean.is_empty() { b"Unknown" } else { clean.as_bytes() });
+            record.push(0);
+        }
+        record.push(0);
+        record
+    }
+
+    pub fn valid(bytes: &[u8]) -> bool {
+        bytes.len() > 0x1b + 6 && bytes[0] == 1 && bytes[1] == 0x1b && bytes.ends_with(&[0, 0])
+            && bytes[6] != 0 && bytes[7] != 0 && bytes[8..24].iter().any(|b| *b != 0)
+    }
+
+    fn random<const N: usize>() -> io::Result<[u8; N]> {
+        let mut bytes = [0u8; N];
+        fs::File::open("/dev/urandom")?.read_exact(&mut bytes)?;
+        Ok(bytes)
+    }
+
+    fn hex(bytes: &[u8]) -> String {
+        bytes.iter().map(|b| format!("{b:02X}")).collect()
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        #[test]
+        fn synthesized_record_round_trips_through_the_linux_parser() {
+            let uuid = [7u8; 16];
+            let record = synthesize(&uuid, "ABCDEF0123", "Ayn", "Odin 3");
+            assert!(valid(&record));
+            let (version, serial, parsed_uuid) = super::super::parse_smbios(&record);
+            assert_eq!(version, b"1.0");
+            assert_eq!(serial, b"ABCDEF0123");
+            assert_eq!(parsed_uuid[0], 7);
+            assert_eq!(parsed_uuid[6] & 0xf0, 0x40);
+        }
+
+        #[test]
+        fn identity_is_created_once_and_then_stable() {
+            let dir = tempfile::tempdir().unwrap();
+            let path = dir.path().join("nested/identity.bin");
+            let first = load_or_create(&path).unwrap();
+            let second = load_or_create(&path).unwrap();
+            assert_eq!(first, second);
+            fs::write(&path, b"broken").unwrap();
+            assert!(load_or_create(&path).is_err(), "never silently replace a bound identity");
+        }
+
+        #[test]
+        fn provisioning_components_carry_the_synthetic_record() {
+            let dir = tempfile::tempdir().unwrap();
+            // SAFETY: test-only, single-threaded use of this variable.
+            unsafe { std::env::set_var(IDENTITY_FILE_ENV, dir.path().join("id.bin")) };
+            let components = super::super::probe_provision_components();
+            unsafe { std::env::remove_var(IDENTITY_FILE_ENV) };
+            let json = serde_json::to_string(&components).unwrap();
+            // 4100 (version), 4101 (serial) and 4102 (UUID) must not be error entries.
+            assert!(json.matches("4102").count() >= 1);
+            assert!(dir.path().join("id.bin").exists());
+        }
+    }
+}
